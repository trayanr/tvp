  "recipeOrigin": {
    "repository": "https://github.com/NixOS/nixpkgs",
    "revision": "97059e5ecd707df94f104cfd77b0ac0e2c14881c",
    "directory": "pkgs/os-specific/linux/minimal-bootstrap",
    "license": "MIT; retain per-file GPL-3.0-or-later notices",
    "adaptations": [
      "Owned pure scope/raw derivation adapter",
      "Fetch Stage0 source components separately at the release's gitlink revisions",
      "Use builtin source downloaders",
      "Explicit empty PATH on raw derivations",
      "Initialize Mes wait status for M2's word-sized int",
      "Port only the required tool/musl/GCC 4.6 closure and exact upstream overrides",
      "Declare native musl platform tuple; retain old config.sub tuple workaround",
      "Use owned shells and a declared musl loader in TinyCC specs",
      "Bind GCC default library searches, assembler/linker and every loader spec alternative to owned outputs",
      "Select musl wrapper bin output explicitly in upstream C tests",
      "Use owned interpreters in installed GCC maintenance scripts; omit unneeded Bash bug mailer",
      "Preserve wordexp shell argv[0] while searching declared PATH with execlp",
      "Port pinned GCC10.4.0 with in-tree GMP6.2.1/MPFR4.2.2/MPC1.4.1 and without ISL; preserve bounded upstream configuration",
      "Select musl.bin for Tar1.35 native CC; omit unused host-dependent bzip2 pager/grep/diff scripts",
      "Use fixed native store and Bash arrays in GCC wrappers to preserve caller argument boundaries",
      "Pass caller RPATHs as separate linker arguments so commas remain part of the path"
    ]
  },
