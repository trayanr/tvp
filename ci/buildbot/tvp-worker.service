[Unit]
Description=TVP trusted-repository CI worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tvp-worker
Group=tvp-worker
StateDirectory=tvp-worker
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tvp-worker
Environment=TVP_CI_WORKER_PASSWORD_FILE=/var/lib/tvp-worker/worker-password
Environment=TVP_CI_WORKER_DIRECTORY=/var/lib/tvp-worker
Environment=PATH=/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
Environment=NIX_BUILD_SHELL=/bin/bash
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/nix/var/nix/profiles/default/bin/nix-shell /srv/tvp-ci/current/ci/buildbot/shell.nix --run "twistd --nodaemon --logfile=- --python /srv/tvp-ci/current/ci/buildbot/worker.tac"
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
