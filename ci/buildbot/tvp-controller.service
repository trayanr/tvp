[Unit]
Description=TVP local CI controller

[Service]
Type=simple
WorkingDirectory=%h/.local/state/tvp-ci/controller
Environment=TVP_CI_SOURCE=/srv/tvp-ci/current
Environment=TVP_CI_CONFIG=%h/.local/state/tvp-ci/controller/config.json
Environment=PATH=/nix/var/nix/profiles/default/bin:/usr/local/bin:/usr/bin:/bin
Environment=NIX_BUILD_SHELL=/bin/bash
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/nix/var/nix/profiles/default/bin/nix-shell /srv/tvp-ci/current/ci/buildbot/shell.nix --run "buildbot start --nodaemon %h/.local/state/tvp-ci/controller"
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=default.target
