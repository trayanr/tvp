# Test support: locale data generated by the selected source-owned GNU libc.
# The matching upstream locale sources are data, never a legacy locale archive.
{ builder, base, bash, coreutils, tar, xz, libc }:
builder {
  recipe = { src, libc }: final: {
    pname = "tvp-command-tools-french-locale";
    version = "2.39";
    inherit base bash coreutils src;
    plan = [ ((base.environment { tools = [ tar xz libc ]; }) // {
      name = "locale.generate";
      run = ''
        ${tar}/bin/tar -xJf ${final.src} glibc-2.39/localedata
        mkdir -p "$out/fr_FR.UTF-8"
        I18NPATH="$PWD/glibc-2.39/localedata" ${libc}/bin/localedef --no-archive \
          -i fr_FR -f "$PWD/glibc-2.39/localedata/charmaps/UTF-8" "$out/fr_FR.UTF-8"
        LOCPATH="$out" LC_ALL=fr_FR.UTF-8 ${libc}/bin/locale charmap | grep -Fx UTF-8
      '';
    }) ];
  };
  args = {
    inherit libc;
    src = import <nix/fetchurl.nix> {
      url = "https://mirrors.kernel.org/gnu/glibc/glibc-2.39.tar.xz";
      sha256 = "sha256-93vUfPgXDFc2Wue/hmlsEYrbOxINMlnGTFAtPcHi2SY=";
    };
  };
  dependencyNames = [ "libc" ];
  metadata.kind = "owned-test-support";
  selection.kind = "owned-test-support";
  mkTests = _: { };
}
