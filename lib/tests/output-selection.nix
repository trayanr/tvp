# Tiny owned fixtures: no catalogue or package compilation.
{
  candidate ? import ../../bases/source-gnu { },
}:
let
  inherit (candidate) lib base tools;
  inherit (tools)
    bash
    coreutils
    python
    binutils
    patchelf
    ;
  output = import ../native-output-steps.nix { inherit lib; };
  steps = import ../build-steps.nix;
  lower = import ../owned-build.nix { inherit lib; };
  loader = "${base.compiler.libc}/lib/ld-linux-x86-64.so.2";
  template = builtins.toFile "output-selection-template" "@Prefix@\n";
  # Each operation must see the secondary root, never the primary sentinel.
  operations = selection: [
    (output.template (
      selection
      // {
        inherit python template;
        path = "config/prefix";
        values.Prefix = "@OUTPUT@";
      }
    ))
    (output.relocateText (
      selection
      // {
        inherit python;
        paths = [ "config/self" ];
      }
    ))
    (output.shebangs (
      selection
      // {
        inherit python;
        paths = [ "scripts" ];
        names = [ "sh" ];
        interpreter = "${bash}/bin/bash";
      }
    ))
    (
      (output.shebangs (
        selection
        // {
          inherit python;
          paths = [ "self-scripts" ];
          names = [ "sh" ];
          selfInterpreter = "interpreter";
        }
      ))
      // {
        name = "output.self-shebangs";
      }
    )
    (output.interpreters (
      selection
      // {
        inherit
          python
          binutils
          patchelf
          loader
          ;
        paths = [ "bin" ];
      }
    ))
    (output.strip (
      selection
      // {
        inherit python binutils;
        paths = [ "bin" ];
        elfKinds = [ "runtime" ];
      }
    ))
    (output.stripArchives (
      selection
      // {
        inherit python binutils;
        paths = [ "archives" ];
      }
    ))
    (output.libtool (
      selection
      // {
        inherit python;
        paths = [ "lib" ];
      }
    ))
    (output.hostELF (
      selection
      // {
        inherit
          python
          binutils
          patchelf
          loader
          ;
        paths = [ "host" ];
        libraries = [ base.compiler.libc ];
      }
    ))
    (
      (output.hostELF (
        selection
        // {
          inherit
            python
            binutils
            patchelf
            loader
            ;
          paths = [ "host-executables" ];
          libraries = [ base.compiler.libc ];
          executablesOnly = true;
        }
      ))
      // {
        name = "output.host-executables";
      }
    )
    (output.rpaths (
      selection
      // {
        inherit
          python
          binutils
          patchelf
          base
          ;
        paths = [ "bin/tool" ];
        libraries = [ ];
      }
    ))
    (
      (output.rpaths (
        selection
        // {
          inherit
            python
            binutils
            patchelf
            base
            ;
          paths = [ "bin/forced" ];
          libraries = [ ];
          forceRpath = true;
          dlopenDirectories = [ "${base.compiler.libc}/lib" ];
        }
      ))
      // {
        name = "output.forced-rpaths";
      }
    )
    (output.development (
      selection
      // {
        inherit python;
        libraries = [ coreutils ];
      }
    ))
    (output.checkSymlinks (
      selection
      // {
        inherit python;
        paths = [ "lib/alias" ];
      }
    ))
    (output.checkSymlinkTree (
      selection
      // {
        inherit python;
        paths = [ "lib" ];
      }
    ))
    (output.checkPaths (
      selection
      // {
        inherit python binutils patchelf;
        paths = [ "bin" ];
        elfKinds = [ "runtime" ];
      }
    ))
  ];
  selected = operations { output = "bin"; };
  makeSpec = plan: {
    pname = "output-selection";
    version = "1";
    src = null;
    inherit
      base
      bash
      coreutils
      plan
      ;
    outputs = [
      "out"
      "bin"
    ];
  };
  fixturePlan = [
    (
      (base.environment {
        tools = [
          binutils
          patchelf
        ];
      })
      // {
        name = "fixture.install";
        run = ''
          mkdir -p "$out" "$bin"/{bin,lib,archives,config,scripts,self-scripts,host,host-executables}
          printf primary > "$out/sentinel"
          printf '%s' "$bin" > "$bin/config/self"
          printf '#!/bin/sh\nprintf selected\n' > "$bin/scripts/tool"
          cp "$bin/scripts/tool" "$bin/self-scripts/tool"
          cp ${bash}/bin/bash "$bin/interpreter"
          chmod +x "$bin/scripts/tool" "$bin/self-scripts/tool"
          printf '# Generated by libtool\nold_library=\x27\x27\ndependency_libs=\x27-lmissing\x27\n' > "$bin/lib/example.la"
          cat > library.c <<'EOF'
          int selected(void) { return 42; }
          EOF
          cat > main.c <<'EOF'
          extern int puts(const char *); extern int selected(void);
          int main(void) { return selected() != 42 || puts("42") < 0; }
          EOF
          "$CC" -g -fPIC -shared library.c -Wl,-soname,libselected.so.1 -o "$bin/lib/libselected.so.1"
          ln -s libselected.so.1 "$bin/lib/libselected.so"
          ln -s libselected.so.1 "$bin/lib/alias"
          "$CC" -g main.c -L"$bin/lib" -lselected -Wl,-rpath,"$bin/lib" -o "$bin/bin/tool"
          cp "$bin/bin/tool" "$bin/bin/forced"
          ${patchelf}/bin/patchelf --set-interpreter /missing-interpreter "$bin/bin/tool"
          ${patchelf}/bin/patchelf --set-interpreter /missing-interpreter "$bin/bin/forced"
          for directory in host host-executables; do
            "$CC" -g main.c -L"$bin/lib" -lselected -o "$bin/$directory/tool"
            ${patchelf}/bin/patchelf --set-rpath '$ORIGIN/../lib' "$bin/$directory/tool"
          done
          "$CC" -g -c library.c -o selected.o
          ${binutils}/bin/ar crD "$bin/archives/libselected.a" selected.o
        '';
      }
    )
    (steps.split "fixture.finalize")
    (output.copyArtifacts {
      inherit coreutils;
      outputs = [
        "out"
        "bin"
      ];
    })
  ] ++ selected;
  fixture = lower (makeSpec fixturePlan);
  # An unsplit named plan has no artifact map. Non-rebasing operations still work.
  unsplit = lower (
    (makeSpec [
      {
        name = "fixture.install";
        run = ''mkdir -p "$out" "$bin/config"; printf primary > "$out/sentinel"'';
      }
      (builtins.head selected)
    ])
    // {
      pname = "output-selection-unsplit";
    }
  );
  singleton =
    preserveHardlinks:
    lower (
      (makeSpec [
        {
          name = "fixture.install";
          run = ''
            mkdir "$out"
            printf installed > "$out/message"
            ln "$out/message" "$out/alias"
          '';
        }
        (steps.split "fixture.finalize")
        (output.copyArtifacts {
          inherit coreutils preserveHardlinks;
          outputs = [ "out" ];
        })
      ])
      // {
        pname = "output-singleton-${if preserveHardlinks then "linked" else "private"}";
        outputs = [ "out" ];
      }
    );
  render = plan: (lower (makeSpec plan)).drvPath;
  rejects = value: !(builtins.tryEval (builtins.deepSeq value true)).success;
  malformed = [
    ""
    "../bin"
    "bin;touch"
    "Bin"
    "bash"
    1
    null
    [ "bin" ]
  ];
  contracts = {
    explicitDefault =
      map (s: s.run) (operations { }) == map (s: s.run) (operations {
        output = "out";
      });
    selectedNames = map (s: s.name) selected == map (s: s.name) (operations { });
    declaredSelection = builtins.all (
      s: s.outputSelection == "bin" && lib.hasInfix ''"$bin"'' s.run
    ) selected;
    singletonCopy =
      builtins.all
        (
          preserveHardlinks:
          (output.copyArtifacts { inherit coreutils preserveHardlinks; }).run == (output.copyArtifacts {
            inherit coreutils preserveHardlinks;
            outputs = [ "out" ];
          }).run
        )
        [
          true
          false
        ];
    malformedSelection = builtins.all (
      name:
      rejects
        (output.libtool {
          inherit python;
          output = name;
          paths = [ "lib" ];
        }).run
    ) malformed;
    contextualSelection =
      rejects
        (output.libtool {
          inherit python;
          output = builtins.appendContext "bin" (builtins.getContext "${coreutils}");
          paths = [ "lib" ];
        }).run;
    undeclaredSelection = rejects (render [
      (output.libtool {
        inherit python;
        output = "dev";
        paths = [ "lib" ];
      })
    ]);
    completeCopySelection = rejects (render [
      (output.copyArtifacts {
        inherit coreutils;
        outputs = [ "out" ];
      })
      {
        name = "fixture.secondary";
        run = ''mkdir -p "$bin"'';
      }
    ]);
    workspaceConflict = rejects (
      output.rpaths {
        inherit python binutils patchelf;
        output = "bin";
        paths = [ "bin" ];
        workspaceRoot = "source";
      }
    );
    contextualWorkspace =
      rejects
        (output.rpaths {
          inherit python binutils patchelf;
          output = builtins.appendContext "out" (builtins.getContext "${coreutils}");
          paths = [ "bin" ];
          workspaceRoot = "source";
        }).run;
    reorderedCopySelection =
      builtins.isString
        (lower (
          (makeSpec [
            (output.copyArtifacts {
              inherit coreutils;
              outputs = [
                "out"
                "dev"
                "bin"
              ];
            })
          ])
          // {
            outputs = [
              "out"
              "bin"
              "dev"
            ];
          }
        )).drvPath;
    duplicateNames = rejects (render [
      (builtins.head selected)
      (builtins.head selected)
    ]);
    disabledSelection = builtins.isString (render [
      {
        name = "fixture.active";
        run = ":";
      }
      (
        (builtins.head selected)
        // {
          enabled = false;
          outputSelection = throw "disabled selection";
        }
      )
    ]);
    selectedDevelopment = (builtins.elemAt selected 12).developmentLibraries == [ coreutils ];
  };
  # Changing a suffix helper's output must leave the compilation artifact exact.
  changed = lower (
    (makeSpec fixturePlan)
    // {
      plan = steps.replace "output.development" (
        _:
        output.development {
          inherit python;
          libraries = [ coreutils ];
          output = "out";
        }
      ) fixturePlan;
    }
  );
  results = contracts // {
    finalOnly =
      changed.artifact.drvPath == fixture.artifact.drvPath && changed.drvPath != fixture.drvPath;
  };
  failed = builtins.filter (name: !results.${name}) (builtins.attrNames results);
  check = builtins.derivation {
    name = "tvp-output-selection-contracts";
    system = base.platform.system;
    builder = "${bash}/bin/bash";
    args = [
      "-euc"
      ''
        export PATH=${coreutils}/bin
        test "$(cat ${singleton true}/message)" = installed
        test "$(stat -c %h ${singleton true}/message)" = 2
        test "$(cat ${singleton false}/message)" = installed
        test "$(stat -c %h ${singleton false}/message)" = 1
        test "$(cat ${fixture}/sentinel)" = primary
        test "$(cat ${fixture.bin}/config/self)" = '${fixture.bin}'
        test "$(cat ${fixture.bin}/config/prefix)" = '${fixture.bin}'
        test "$(cat ${unsplit.bin}/config/prefix)" = '${unsplit.bin}'
        test "$(cat ${unsplit}/sentinel)" = primary
        test "$(head -n1 ${fixture.bin}/scripts/tool)" = '#!${bash}/bin/bash'
        test "$(head -n1 ${fixture.bin}/self-scripts/tool)" = '#!${fixture.bin}/interpreter'
        test "$(cat ${fixture.bin}/nix-support/propagated-build-inputs)" = '${coreutils} '
        test "$(cat ${fixture.bin}/lib/example.la)" = "$(printf '# Generated by libtool\nold_library=\x27\x27\ndependency_libs=\x27\x27 #pruned')"
        for binary in bin/tool bin/forced host/tool host-executables/tool; do
          test "$("${fixture.bin}/$binary")" = 42
          test "$(${patchelf}/bin/patchelf --print-interpreter "${fixture.bin}/$binary")" = '${loader}'
        done
        rpath=$(${patchelf}/bin/patchelf --print-rpath ${fixture.bin}/bin/tool)
        [[ ":$rpath:" == *':${fixture.bin}/lib:'* ]]
        [[ "$rpath" != *'${fixture.artifact.bin}'* ]]
        dynamic=$(${binutils}/bin/readelf -d ${fixture.bin}/bin/forced)
        [[ "$dynamic" == *'(RPATH)'* && "$dynamic" != *'(RUNPATH)'* ]]
        sections=$(${binutils}/bin/readelf -S ${fixture.bin}/bin/tool)
        [[ "$sections" != *'.debug_info'* ]]
        ${binutils}/bin/ar x ${fixture.bin}/archives/libselected.a
        sections=$(${binutils}/bin/readelf -S selected.o)
        [[ "$sections" != *'.debug_info'* ]]
        printf '%s\n' ${lib.escapeShellArg (builtins.toJSON results)} > "$out"
      ''
    ];
  };
in
assert failed == [ ] || throw "Output selection contracts: ${lib.concatStringsSep ", " failed}";
{
  inherit
    results
    fixture
    unsplit
    check
    ;
}
