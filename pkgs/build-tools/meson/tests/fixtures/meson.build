project('answer', ['c', 'cpp'], version: '1.0.0')
zlib_pc = dependency('zlib', method: 'pkg-config')
zlib_cmake = dependency('ZLIB', method: 'cmake')
shared = shared_library('answer_shared', 'answer.c', dependencies: zlib_pc, install: true)
static = static_library('answer_static', 'answer.c', dependencies: zlib_cmake, install: true)
answer = executable('answer', 'main.cc', link_with: shared, install: true, install_rpath: join_paths(get_option('prefix'), get_option('libdir')))
static_test = executable('answer_static_test', 'main.cc', link_with: static, dependencies: zlib_cmake)
test('shared', answer)
test('static', static_test)
