# Dated GNU Config Git snapshot: install scripts, then bind final runtime shell.
{
  tvp,
  lib,
  base,
  src,
  version,
  revision,
  doCheck ? true,
}:
final:
let
  context = tvp.builder.forBase final.base;
  inherit (context) steps outputs tools;
  environment = final.base.environment final.environment;
  command =
    name: run:
    environment
    // {
      name = "gnu-config.${name}";
      inherit run;
      cwd = "source";
    };
  checkpoint = "nix-support/gnu-config-source-tree";
in
{
  pname = "gnu-config";
  inherit
    base
    src
    version
    revision
    doCheck
    ;
  inherit (tools) bash coreutils;
  environment = {
    tools = [
      tools.sed
      tools.gawk
      tools.grep
    ];
    libraries = [ ];
  };
  runtime.shell = tools.bash;
  productionPlan = [
    {
      name = "source.copy";
      tools = [ tools.coreutils ];
      run = ''
        cp -R ${final.src} source
        chmod -R u+w source
        # Git sources have normalized store mtimes. This is a source snapshot,
        # not the date/version identity, which is the explicit pinned revision.
        printf '%s\n' 315532800 > source-date-epoch
      '';
    }
    (command "install" ''
      install -Dm755 config.guess "$out/config.guess"
      install -Dm755 config.sub "$out/config.sub"
      install -Dm644 ChangeLog-old "$out/share/doc/gnu-config/ChangeLog-old"
      printf '%s\n' '${final.revision}' > "$out/share/doc/gnu-config/revision"
    '')
    (
      (command "save-source-tree" ''
        ${tools.python}/bin/python3 -B ${../../../lib/build-checkpoint.py} "$TVP_SOURCE_ROOT" "$out/${checkpoint}"
      '')
      // {
        tools = environment.tools ++ [ tools.python ];
      }
    )
  ];
  upstreamPlan = artifact: [
    {
      name = "gnu-config.restore-source-tree";
      tools = [ tools.python ];
      run = ''${tools.python}/bin/python3 -B ${./tests/restore.py} ${artifact}/${checkpoint} "$TVP_SOURCE_ROOT"'';
    }
  ];
  upstreamCheck =
    (command "upstream" ''
      cd testsuite
      # These are the two mock interpreter directives generated by the harness.
      test "$(${tools.grep}/bin/grep -c '^#!/bin/sh$' config-guess.sh)" = 2
      ${tools.sed}/bin/sed 's|^#!/bin/sh$|#!${tools.bash}/bin/bash|' config-guess.sh > config-guess-selected.sh
      sub=0; guess=0
      ${tools.bash}/bin/bash config-sub.sh > config-sub.log 2>&1 || sub=$?
      ${tools.bash}/bin/bash config-guess-selected.sh > config-guess.log 2>&1 || guess=$?
      cat config-sub.log config-guess.log >&2
      printf '%s\n' "$sub" > config-sub.exit
      printf '%s\n' "$guess" > config-guess.exit
      printf 'config-sub.sh exit=%s; config-guess.sh exit=%s\n' "$sub" "$guess" >&2
      if (( sub )); then exit "$sub"; fi
      if (( guess )); then exit "$guess"; fi
      for fixture in uname ldd; do
        IFS= read -r interpreter < "$fixture"
        test "$interpreter" = '#!${tools.bash}/bin/bash'
        printf '%s: %s\n' "$fixture" "$interpreter"
      done
    '')
    // {
      enabled = final.doCheck;
    };
  plan = final.productionPlan ++ [
    (steps.split "gnu-config.finalize")
    (outputs.copyArtifacts { })
    {
      name = "gnu-config.drop-source-tree";
      tools = [ tools.coreutils ];
      run = ''${tools.coreutils}/bin/rm -rf -- "$out/${checkpoint}"'';
    }
    (outputs.shebangs {
      paths = [
        "config.guess"
        "config.sub"
      ];
      names = [ "sh" ];
      interpreter = "${final.runtime.shell}/bin/bash";
    })
  ];
  meta = {
    description = "GNU system type detection and canonicalisation scripts";
    homepage = "https://savannah.gnu.org/projects/config/";
    license = {
      spdxId = "GPL-3.0-or-later WITH Autoconf-exception-generic-3.0";
      fullName = "GNU GPL v3 or later with the Autoconf distribution exception";
      free = true;
      url = "https://git.savannah.gnu.org/cgit/config.git/tree/config.guess";
    };
    mainProgram = "config.guess";
  };
  tvp.revision = final.revision;
}
