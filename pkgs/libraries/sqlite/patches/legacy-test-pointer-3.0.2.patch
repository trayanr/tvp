+++ b/src/tvp-test-pointer-compat.h
@@ -0,0 +1,58 @@
+/* Test-only pointer text compatibility; never part of SQLite library objects. */
+#ifndef TVP_TEST_POINTER_COMPAT_H
+#define TVP_TEST_POINTER_COMPAT_H
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+/* The output owns a real void* object; do not alias a typed pointer as void**. */
+static int tvpTestGetPointer(Tcl_Interp *interp, const char *text, void **result){
+  const unsigned char *p = (const unsigned char *)text;
+  uintptr_t value = 0;
+  int digits = 0, consumed = 0;
+  void *pointer = 0;
+  if( p[0]=='0' && (p[1]=='x' || p[1]=='X') ) p += 2;
+  while( *p ){
+    unsigned digit;
+    if( *p>='0' && *p<='9' ) digit = *p-'0';
+    else if( *p>='a' && *p<='f' ) digit = *p-'a'+10;
+    else if( *p>='A' && *p<='F' ) digit = *p-'A'+10;
+    else goto invalid;
+    if( digits==2*sizeof(uintptr_t) ) goto invalid;
+    if( value>(UINTPTR_MAX-digit)/16 ) goto invalid;
+    value = value*16+digit;
+    ++digits;
+    ++p;
+  }
+  if( !digits ) goto invalid;
+  if( sscanf(text, "%p%n", &pointer, &consumed)!=1 || text[consumed]!=0 ){
+    goto invalid;
+  }
+  *result = pointer;
+  return TCL_OK;
+invalid:
+  Tcl_AppendResult(interp, "\"", text, "\" is not a valid pointer value", 0);
+  return TCL_ERROR;
+}
+
+static int tvpTestMakePointerStr(
+  Tcl_Interp *interp, char *buffer, size_t size, void *pointer
+){
+  int written;
+  /* Keep null numeric; %p may otherwise emit a nonnumeric implementation token. */
+  if( pointer==0 ) written = snprintf(buffer, size, "0x0");
+  else written = snprintf(buffer, size, "%p", pointer);
+  if( written<0 || (size_t)written>=size ){
+    Tcl_AppendResult(interp, "unable to convert a pointer to a string", 0);
+    return TCL_ERROR;
+  }
+  return TCL_OK;
+}
+
+#define TVP_TEST_GET_POINTER(interp, text, target) do { \
+  void *tvpTestPointer; \
+  if( tvpTestGetPointer((interp), (text), &tvpTestPointer)!=TCL_OK ) \
+    return TCL_ERROR; \
+  (target) = tvpTestPointer; \
+} while(0)
+#endif
