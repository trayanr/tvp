{ pkgs, tvp, ... }:
let
  inherit (pkgs) lib;
  pname = "imagemagick";
  archiveDirectory = "https://download.imagemagick.org/archive/releases/";
  releasePattern = "([67][.][0-9]+[.][0-9]+)-([0-9]+)";
  upstreamTag =
    version:
    let
      match = builtins.match "([67][.][0-9]+[.][0-9]+)[.]([0-9]+)" version;
    in
    "${builtins.head match}-${builtins.elemAt match 1}";
  discovery = {
    type = "directory-index";
    url = archiveDirectory;
    scope = "Stable ImageMagick 6 and 7 source tarballs listed in the official release archive.";
    pattern = "href=\"ImageMagick-${releasePattern}[.]tar[.]xz\"";
    normalise =
      entry:
      let
        match = builtins.match "href=\"ImageMagick-${releasePattern}[.]tar[.]xz\"" entry;
      in
      if match == null then null else "${builtins.head match}.${builtins.elemAt match 1}";
  };
  archiveName = version: "ImageMagick-${upstreamTag version}.tar.xz";
  source = tvp.lib.sources.archive {
    url = version: archiveDirectory + archiveName version;
    fetch =
      { version, sha256 }:
      let
        name = archiveName version;
      in
      tvp.lib.sources.fetchMirrors {
        certificates = tvp.packages.ca-certificates;
        urls = [
          "https://mirror.dogado.de/imagemagick/releases/${name}"
          "https://mirror.metanet.ch/imagemagick/releases/${name}"
          (archiveDirectory + name)
        ];
        inherit name sha256;
      };
    inherit discovery;
  };
  tagSource = tvp.lib.sources.archive {
    url =
      version:
      let
        repository = if lib.versionAtLeast version "7" then "ImageMagick" else "ImageMagick6";
      in
      "https://codeload.github.com/ImageMagick/${repository}/tar.gz/refs/tags/${upstreamTag version}";
    inherit discovery;
  };
  versionTable = tvp.lib.packages.mkTable [
    # These releases use png_info fields that libpng 1.6 makes opaque.
    {
      def = {
        builder = ./build.nix;
        deps = {
          bzip2 = tvp.packages.bzip2;
          fontconfig = tvp.packages.fontconfig;
          freetype = tvp.packages.freetype;
          jpeg = tvp.packages.libjpeg-turbo;
          lcms2 = tvp.packages.lcms2;
          libice = tvp.packages.libice;
          libsm = tvp.packages.libsm;
          libtiff = tvp.packages.libtiff;
          libx11 = tvp.packages.libx11;
          libxext = tvp.packages.libxext;
          libxml2 = tvp.packages.libxml2_2;
          libxt = tvp.packages.libxt;
          perl = tvp.packages.perl_5;
          zlib = tvp.packages.zlib_1;
        };
      };
